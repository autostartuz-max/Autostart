generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int        @id @default(autoincrement())
  code      String     @unique // "B", "C", "D"...
  name      String
  questions Question[]
  tickets   Ticket[]
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  order     Int        @default(0)
  questions Question[]
}

model Ticket {
  id         Int        @id @default(autoincrement())
  name       String
  order      Int        @default(0)
  categoryId Int?
  category   Category?  @relation(fields: [categoryId], references: [id])
  questions  Question[]
}

model Question {
  id          Int          @id @default(autoincrement())
  categoryId  Int?
  category    Category?    @relation(fields: [categoryId], references: [id])
  topicId     Int?
  topic       Topic?       @relation(fields: [topicId], references: [id])
  ticketId    Int?
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  textLat     String
  textCyr     String       @default("")
  textRus     String       @default("") // rus tili (tarjima)
  imageUrl    String?
  shablon     Int?         // qaysi shablon (1-63) ga tegishli
  order       Int          @default(0) // admin belgilagan tartib raqami
  explanation String       @default("")
  ruleRef     String?
  difficulty  Int          @default(1)
  isNumeric   Boolean      @default(false)
  isTricky    Boolean      @default(false)
  status      String       @default("published") // draft | published
  hasAudio    Boolean      @default(false) // Tushuncha uchun ovoz yuklanganmi
  createdAt   DateTime     @default(now())
  options     Option[]
  answers     UserAnswer[]
  bookmarks   Bookmark[]
  complaints  Complaint[]
  audio       QuestionAudio?
  image       QuestionImage?
}

model QuestionAudio {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  data       Bytes
  mime       String   @default("audio/mpeg")
  createdAt  DateTime @default(now())
}

model QuestionImage {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  data       Bytes
  mime       String   @default("image/jpeg")
  createdAt  DateTime @default(now())
}

model Option {
  id          Int      @id @default(autoincrement())
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textLat     String
  textCyr     String   @default("")
  textRus     String   @default("")
  isCorrect   Boolean  @default(false)
  wrongReason String?
  order       Int      @default(0)
}

model User {
  id           Int          @id @default(autoincrement())
  tgId         String?      @unique
  phone        String?      @unique
  // Telefon o'rniga pochta bilan ham ro'yxatdan o'tish mumkin.
  // Kamida bittasi (telefon yoki pochta) bo'lishi shart — buni API tekshiradi.
  email        String?      @unique
  passwordHash String?
  // Admin panelida parolni ko'rsatish uchun shifrlangan nusxa (AES-256-GCM).
  // Kirish tekshiruvi baribir passwordHash bo'yicha — bu faqat ko'rsatish uchun.
  // Eski hisoblarda bo'sh: bcrypt hashdan asl parolni tiklab bo'lmaydi.
  passwordEnc  String?
  firstName    String       @default("Foydalanuvchi")
  // owner | admin | user
  //   owner — to'liq huquq: savollar + rollarni tayinlash
  //   admin — faqat savollarni ko'rish/qo'shish/tahrirlash
  //   user  — oddiy talaba (standart)
  // PATCH /me bu maydonni QABUL QILMAYDI (huquq oshirishning oldini olish uchun);
  // faqat /admin/users/:id/role orqali, FAQAT owner tomonidan o'zgartiriladi.
  role         String       @default("user")
  avatarUrl  String?
  lang       String       @default("uz")
  alphabet   String       @default("lat") // lat | cyr
  category   String       @default("B")
  examDate   DateTime?
  createdAt  DateTime     @default(now())
  // Oxirgi faollik vaqti — "hozir nechta odam ishlayapti" ni hisoblash uchun.
  // Har so'rovda emas, daqiqada bir marta yangilanadi (ortiqcha yozuvning oldini olish).
  lastSeen   DateTime?
  answers    UserAnswer[]
  bookmarks  Bookmark[]
  complaints Complaint[]
}

model UserAnswer {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  isCorrect  Boolean
  chosen     String   @default("[]") // JSON array of option ids
  timeMs     Int      @default(0)
  answeredAt DateTime @default(now())
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model Complaint {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("new") // new | reviewing | resolved
  createdAt  DateTime @default(now())
}

model RoadSign {
  id          Int     @id @default(autoincrement())
  category    String
  name        String
  imageUrl    String?
  description String  @default("")
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  login        String @unique
  passwordHash String
  role         String @default("admin")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  subject   String   @default("")
  text      String
  // new = o'qilmagan, read = o'qilgan, done = javob berilgan
  status    String   @default("new")
  // Kim yuborgani (kirgan bo'lsa). Mehmon yuborsa null.
  userId    Int?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Amaliy mashg'ulot — toifalar (A, B, C, E...) bo'yicha video darslik.
/// Video faylning O'ZI bazada saqlanmaydi, diskda yotadi (apps/api/uploads/lessons).
/// Sabab: bitta dars 50–500 MB bo'ladi; Postgres'ga solish bazani va har kunlik
/// zaxira nusxani shishirib yuboradi, oqim (Range) bilan uzatish ham qiyinlashadi.
model Lesson {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  /// Toifa kodi: A | B | C | D | E | BC | CE | Boshqa
  category    String   @default("B")
  /// Toifa ichidagi tartib — kichigi yuqorida turadi
  order       Int      @default(0)
  /// Diskdagi fayl nomi (uploads/lessons ichida). Manzil emas — faqat nom.
  fileName    String
  /// Admin yuklagan asl fayl nomi — ro'yxatda ko'rsatish uchun
  origName    String   @default("")
  mime        String   @default("video/mp4")
  /// Fayl hajmi baytda. Int EMAS: uning chegarasi ~2 GB, darslar esa 1 GB dan
  /// boshlanadi va undan katta bo'ladi. Float (double) 2^53 baytgacha aniq.
  sizeBytes   Float    @default(0)
  /// draft — faqat adminga ko'rinadi, published — foydalanuvchilarga ham
  status      String   @default("published")
  createdAt   DateTime @default(now())

  @@index([category, order])
}
